# Backend environment variables — copy to .env and fill in values
# NEVER commit .env to version control

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/autara

# Express server port
PORT=4000

# Firebase Admin SDK credentials
# Get these from Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# IMPORTANT: paste the private key exactly, preserving the literal \n newlines
# e.g. FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# CORS — comma-separated list of allowed frontend origins (Vite dev server runs on 3000)
ALLOWED_ORIGINS=http://localhost:3000

# Internal AI service (FastAPI). Never exposed to the browser.
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret sent as X-Internal-Key. Must equal AI_SERVICE_KEY in ai-service/.env.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AI_SERVICE_KEY=

# Optional: run backend tests against an existing MongoDB instead of downloading mongodb-memory-server
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017
