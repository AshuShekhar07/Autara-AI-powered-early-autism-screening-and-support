# Root .env — only used by docker-compose.yml (never commit .env)

# Shared secret between the backend and the AI service (sent as X-Internal-Key).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AI_SERVICE_KEY=

# Google Gemini API key for insights, Ask Autara and embeddings (https://aistudio.google.com/apikey).
# Optional: without it screening still works; insights fail gracefully and Ask Autara says it is unavailable.
GEMINI_API_KEY=

# Optional model overrides (defaults shown). Check https://ai.google.dev/gemini-api/docs/models for current names.
# LLM_MODEL=gemini-3.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
