# AI service environment — copy to .env (never commit .env)

# Shared secret. Node sends it as the X-Internal-Key header; must match backend/.env AI_SERVICE_KEY.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_KEY=

# Bind address / port. Keep 127.0.0.1 unless you run in Docker (compose sets 0.0.0.0 inside the container
# and does NOT publish the port to the host).
AI_HOST=127.0.0.1
AI_PORT=8000
