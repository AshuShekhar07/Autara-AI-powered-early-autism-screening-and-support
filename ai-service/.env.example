# AI service environment — copy to .env (never commit .env)

# Shared secret. Node sends it as the X-Internal-Key header; must match backend/.env AI_SERVICE_KEY.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_KEY=

# Bind address / port. Keep 127.0.0.1 unless you run in Docker (compose sets 0.0.0.0 inside the container
# and does NOT publish the port to the host).
AI_HOST=127.0.0.1
AI_PORT=8000

# ── LLM (Google Gemini) ──
# Get a key at https://aistudio.google.com/apikey . Without it the service still runs: /screen works,
# insights come back status=failed (LLM_NOT_CONFIGURED) and Ask Autara says it is unavailable.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
# Generation model and embedding model. Check https://ai.google.dev/gemini-api/docs/models for current names.
LLM_MODEL=gemini-3.5-flash
# Changing EMBEDDING_MODEL requires re-ingesting: python -m app.rag.ingest --reset
EMBEDDING_MODEL=gemini-embedding-001
LLM_TIMEOUT_MS=50000

# ── RAG ──
# Retrieved chunks (top-k) and the minimum cosine similarity to keep a chunk (tune with `python -m eval.run`).
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55
# Optional overrides (defaults: ai-service/storage/chroma and ai-service/knowledge)
# CHROMA_DIR=
# KNOWLEDGE_DIR=
