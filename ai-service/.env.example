# AI service environment — copy to .env (never commit .env)

# Shared secret. Node sends it as the X-Internal-Key header; must match backend/.env AI_SERVICE_KEY.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_KEY=

# Bind address / port. Keep 127.0.0.1 unless you run in Docker (compose sets 0.0.0.0 inside the container
# and does NOT publish the port to the host).
AI_HOST=127.0.0.1
AI_PORT=8000

# ── LLM (Google Gemini) ──
# Get a key at https://aistudio.google.com/apikey . Without it the service still runs: /screen works,
# insights come back status=failed (LLM_NOT_CONFIGURED) and Ask Autara says it is unavailable.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
# Generation model and embedding model. Check https://ai.google.dev/gemini-api/docs/models for current names.
LLM_MODEL=gemini-3.5-flash
# Changing EMBEDDING_MODEL requires re-ingesting: python -m app.rag.ingest --reset
EMBEDDING_MODEL=gemini-embedding-001
LLM_TIMEOUT_MS=50000

# ── RAG ──
# Retrieved chunks (top-k) and the minimum cosine similarity to keep a chunk (tune with `python -m eval.run`).
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55

# ── Ask Autara backup (saves Gemini quota and covers Gemini outages) ──
# Passages are found with the OFFLINE local index (no key, no quota). Build it once:
#   python -m app.rag.ingest --backup   (downloads an ~80 MB model on first use)
# ASK_MODE:
#   auto    = Gemini first; if it fails -> the backup writer (only if BACKUP_LLM_API_KEY is set) -> quoted passages (default)
#   backup  = skip Gemini completely (ZERO Gemini quota for Ask): backup writer -> quoted passages
#   local   = quoted passages only, fully offline (never calls Gemini or the writer)
#   gemini  = Gemini only, no backup
ASK_MODE=auto
# The local model scores lower than Gemini. Tune with:  python -m app.assistant.debug --local "your question"
RAG_BACKUP_MIN_SIMILARITY=0.30
ASK_BACKUP_MAX_PASSAGES=3

# Backup writer: any service with the common "chat completions" API. It only WRITES answers from public passages;
# the child's screening context is never sent to it. Test with:  python -m app.llm.check --backup
#   Groq (free key at console.groq.com):  BASE_URL=https://api.groq.com/openai/v1   MODEL=llama-3.3-70b-versatile   (these are the defaults)
#   Ollama on this laptop (no key):       BASE_URL=http://localhost:11434/v1        MODEL=<a model you pulled>, KEY=ollama (any word)
#   OpenRouter:                           BASE_URL=https://openrouter.ai/api/v1     MODEL=<a model id>
BACKUP_LLM_API_KEY=
# BACKUP_LLM_BASE_URL=https://api.groq.com/openai/v1
# BACKUP_LLM_MODEL=llama-3.3-70b-versatile
BACKUP_LLM_TIMEOUT_MS=12000

# Optional overrides (defaults: ai-service/storage/chroma and ai-service/knowledge)
# CHROMA_DIR=
# KNOWLEDGE_DIR=

# Optional: where a trained probability model is read from (none is trained by default; see docs/MODEL_CARD.md)
# ML_MODEL_PATH=ml/model.joblib
